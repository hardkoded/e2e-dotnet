<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- E2E.WinApp restores the winapp UI Automation library, which ships Windows assets only. -->
    <AssetTargetFallback>$(AssetTargetFallback);net10.0-windows7.0</AssetTargetFallback>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Testbed\control-inventory.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Testbed\playwright\**" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\E2E.Agent.Tests\Testbed.cs" Link="Testbed\Playground.cs" />
    <Compile Include="..\E2E.Agent.Tests\PlaywrightRoutes.cs" Link="Testbed\PlaywrightRoutes.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\E2E.NUnit\E2E.NUnit.csproj" />
    <ProjectReference Include="..\..\src\E2E.Mobile.NUnit\E2E.Mobile.NUnit.csproj" />
    <ProjectReference Include="..\..\src\E2E.WinApp.NUnit\E2E.WinApp.NUnit.csproj" />
  </ItemGroup>
</Project>
