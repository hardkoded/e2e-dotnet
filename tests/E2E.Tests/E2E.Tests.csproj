<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- E2E.Cli reaches E2E.WinApp, which restores the winapp UI Automation library, which ships Windows assets only. -->
    <AssetTargetFallback>$(AssetTargetFallback);net10.0-windows7.0</AssetTargetFallback>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\E2E\E2E.csproj" />
    <!-- e2e cache ls: the listing the trace cache tests read. -->
    <ProjectReference Include="..\..\src\E2E.Cli\E2E.Cli.csproj" />
    <ProjectReference Include="..\E2E.Tests.Schema\E2E.Tests.Schema.csproj" />
    <!-- The program the app-command tests start. Its apphost lands beside the tests. -->
    <ProjectReference Include="..\E2E.Tests.App\E2E.Tests.App.csproj" />
  </ItemGroup>
</Project>
