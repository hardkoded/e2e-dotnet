<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>E2E.XUnit.V3.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- The session already stops on the xUnit cancellation token, so each call does not pass it. -->
    <NoWarn>$(NoWarn);xUnit1051;NU1701</NoWarn>
    <!-- E2E.WinApp restores the winapp UI Automation library, which ships Windows assets only. -->
    <AssetTargetFallback>$(AssetTargetFallback);net10.0-windows7.0</AssetTargetFallback>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\E2E.Agent.Tests\Testbed.cs" Link="Testbed\Playground.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\E2E.XUnit.V3\E2E.XUnit.V3.csproj" />
    <ProjectReference Include="..\..\src\E2E.Mobile.XUnit.V3\E2E.Mobile.XUnit.V3.csproj" />
    <ProjectReference Include="..\..\src\E2E.WinApp.XUnit.V3\E2E.WinApp.XUnit.V3.csproj" />
  </ItemGroup>
</Project>
