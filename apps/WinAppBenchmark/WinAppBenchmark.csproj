<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>WinAppBenchmark</RootNamespace>
    <AssemblyName>WinAppBenchmark</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IsPackable>false</IsPackable>
    <!-- The hidden-tree scenarios break accessibility on purpose, and the benchmark uses fixed colors. -->
    <NoWarn>$(NoWarn);REACTOR_A11Y_001;REACTOR_A11Y_003;REACTOR_A11Y_004;REACTOR_THEME_001;REACTOR_HOOKS_013</NoWarn>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.16" />
  </ItemGroup>
</Project>
