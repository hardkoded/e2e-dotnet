<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>WebBenchmark</RootNamespace>
    <TargetFramework>net11.0</TargetFramework>
    <!-- New in the .NET 11 analyzers: the benchmark app calls JS interop without a try/catch and StateHasChanged on purpose. -->
    <NoWarn>$(NoWarn);BL0012;BL0016</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
