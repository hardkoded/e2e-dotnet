@implements IDisposable
@inject Portal Portal
@* The target of upstream's createPortal(..., document.body): .NET-only, see Portal. *@
@Portal.Content

@code {
    protected override void OnInitialized() => Portal.Changed += OnChanged;

    private async void OnChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception) when (exception is ObjectDisposedException or OperationCanceledException)
        {
            // The circuit is closing: there is no page left to render into.
        }
    }

    public void Dispose() => Portal.Changed -= OnChanged;
}
