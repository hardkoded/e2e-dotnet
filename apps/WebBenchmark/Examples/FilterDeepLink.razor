@using Microsoft.JSInterop
@* Upstream's app/src/Examples/FilterDeepLink.tsx. *@
@inject NavigationManager Navigation
@inject IJSRuntime JS
<div style="@Container">
    <p style="@Hint">Filter the list for mug, then verify the page URL carries the filter as ?q=mug so the view is shareable.</p>
    <input data-testid="filter-input" style="@Input" placeholder="Filter products" value="@_query" @oninput="ApplyFilterAsync" />
    <ul data-testid="product-list" style="@List">
        @foreach (var name in Visible)
        {
            <li @key="name">@name</li>
        }
    </ul>
    @if (!Visible.Any())
    {
        <p data-testid="empty-state">No products match.</p>
    }
</div>

@code {
    private static readonly string[] Products =
    [
        "Trail Backpack",
        "Steel Water Bottle",
        "Merino Hiking Socks",
        "Camp Lantern",
        "Titanium Mug",
    ];

    private const string Container = "display: flex; flex-direction: column; gap: 12px; padding: 24px 0;";
    private const string Hint = "font-size: 13px; color: #666; text-align: center; margin: 0;";
    private const string Input = "border: 1px solid #ccc; border-radius: 8px; padding: 10px 12px; font-size: 15px;";
    private const string List = "margin: 0; padding-left: 20px;";

    private string _query = "";

    private IEnumerable<string> Visible => Products.Where(name => name.Contains(_query, StringComparison.OrdinalIgnoreCase));

    // A shared link carries the filter, so opening ?q=mug must show the filtered view.
    protected override void OnInitialized()
    {
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query)["q"] is { Length: > 0 } shared)
        {
            _query = shared;
        }
    }

    /// <summary>
    /// Mirrors the filter into the URL the way real dashboards do, so the only way to verify the deep link is to read the query string
    /// from the page address. <c>history.replaceState</c> changes the address without navigating, as upstream does.
    /// </summary>
    private async Task ApplyFilterAsync(ChangeEventArgs args)
    {
        _query = args.Value as string ?? "";
        var url = Navigation.GetUriWithQueryParameter("q", _query.Length > 0 ? _query : null);
        try
        {
            await JS.InvokeVoidAsync("history.replaceState", new { }, "", url);
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away: there is no page left to address.
        }
    }
}
