@using System.Globalization
@* Upstream's app/src/Examples/GiftCardPurchase.tsx.
   NO PLANTED PRODUCT BUG - an accessibility-mirage trap. The visible UI is correct and the purchase flow works end to end, but the
   accessibility layer carries bug-looking artifacts: aria labels reading "undefined" and raw i18n keys, template tokens, and a visible
   price hidden from the a11y tree behind a broken sr-only sibling. Do not clean up the aria attributes - they are the trap. *@
@if (_purchased)
{
    <div style="@Container">
        <p data-testid="success-message" style="@SuccessText">Gift card sent to @_email</p>
        <p style="@MutedText">A $@Money(_amount ?? 0) gift card is on its way.</p>
    </div>
}
else
{
    <div style="@Container">
        <p style="@Pitch">Send a digital gift card. Delivered by email within minutes.</p>
        <div style="@AmountRow">
            @foreach (var value in Amounts)
            {
                <button @key="value" type="button" data-testid="amount-@value" aria-label="gift_card_amount_option_undefined" style="@(_amount == value ? AmountButtonActive : AmountButton)" @onclick="() => _amount = value">$@value</button>
            }
        </div>
        <label style="@FieldLabel">
            Recipient email
            <input data-testid="recipient-input" aria-label="{{recipient_email_label}}" style="@Input" placeholder="friend@example.com" type="email" autocapitalize="none" value="@_email" @oninput="HandleEmailInput" />
        </label>
        <div style="@TotalRow">
            <span>Total</span>
            <span>
                <span aria-hidden="true" data-testid="total-amount">$@Money(_amount ?? 0)</span>
                <span style="@SrOnly">Total: $NaN</span>
            </span>
        </div>
        @if (_error is not null)
        {
            <p data-testid="error-message" style="@ErrorText">@_error</p>
        }
        <button type="button" data-testid="buy-button" aria-label="btn_purchase_label" style="@BuyButton" @onclick="HandleBuy">Buy gift card</button>
    </div>
}

@code {
    private static readonly int[] Amounts = [10, 25, 50];

    private const string Container = "display: flex; flex-direction: column; gap: 16px; padding: 24px 0;";
    private const string Pitch = "font-size: 14px; color: #333; margin: 0;";
    private const string AmountRow = "display: flex; gap: 8px;";
    private const string AmountButton = "flex: 1; border: 1px solid #ccc; background-color: #fff; border-radius: 8px; padding: 12px 0; font-size: 16px; font-weight: 600; cursor: pointer;";
    private const string AmountButtonActive = "flex: 1; border: 1px solid #111; background-color: #111; color: #fff; border-radius: 8px; padding: 12px 0; font-size: 16px; font-weight: 600; cursor: pointer;";
    private const string FieldLabel = "display: flex; flex-direction: column; gap: 6px; font-size: 14px; color: #333;";
    private const string Input = "border: 1px solid #ccc; border-radius: 8px; padding: 10px 12px; font-size: 16px;";
    private const string TotalRow = "display: flex; justify-content: space-between; border: 1px solid #e5e5e5; border-radius: 8px; padding: 12px 16px; font-size: 15px; font-weight: 600;";
    private const string SrOnly = "position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;";
    private const string ErrorText = "color: #c00; font-size: 14px; margin: 0;";
    private const string BuyButton = "background-color: #111; color: #fff; border: none; border-radius: 8px; padding: 12px 16px; font-size: 16px; font-weight: 600; cursor: pointer;";
    private const string SuccessText = "font-size: 20px; font-weight: 600; color: #0a0; text-align: center; margin: 0 0 4px;";
    private const string MutedText = "font-size: 13px; color: #666; text-align: center; margin: 0;";

    private int? _amount;
    private string _email = string.Empty;
    private string? _error;
    private bool _purchased;

    private void HandleEmailInput(ChangeEventArgs args) => _email = args.Value?.ToString() ?? string.Empty;

    /// <summary>Validates the form and completes the purchase.</summary>
    private void HandleBuy()
    {
        if (_amount is null)
        {
            _error = "Choose a gift card amount";
            return;
        }

        if (!_email.Contains('@'))
        {
            _error = "Enter a valid recipient email";
            return;
        }

        _error = null;
        _purchased = true;
    }

    private static string Money(int amount) => amount.ToString("F2", CultureInfo.InvariantCulture);
}
