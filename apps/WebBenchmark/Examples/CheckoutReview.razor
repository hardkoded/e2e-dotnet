@* Upstream's app/src/Examples/CheckoutReview.tsx. *@
@if (_placed)
{
    <div style="@Container">
        <p data-testid="success-message" style="@SuccessText">
            Order placed successfully
        </p>
        <p style="@MutedText">Order #10482 - a confirmation email is on its way.</p>
    </div>
}
else
{
    <div style="@Container">
        @* PLANTED BUG (do not fix): the greeting renders a raw template token and the delivery estimate interpolates undefined. *@
        <p data-testid="checkout-greeting" style="@Greeting">@("Thanks, {{firstName}}! Review your order below.")</p>
        <ul data-testid="order-lines" style="@List">
            @foreach (var line in OrderLines)
            {
                <li @key="line.Id" style="@Row">
                    <span>@line.Name x@(line.Quantity)</span>
                    <span style="@LineTotal">$@line.Total.ToString("F2")</span>
                </li>
            }
        </ul>
        <div style="@InfoBlock">
            <p style="@InfoRow"><strong>Ship to:</strong> 221B Baker Street, London</p>
            <p data-testid="delivery-estimate" style="@InfoRow"><strong>Delivery:</strong> @("Arrives by undefined")</p>
            <p style="@InfoRow"><strong>Payment:</strong> Visa ending in 4242</p>
        </div>
        <button type="button" data-testid="place-order-button" style="@Button" @onclick="() => _placed = true">
            Place order - $123.00
        </button>
    </div>
}

@code {
    private sealed record OrderLine(string Id, string Name, int Quantity, int Total);

    private static readonly OrderLine[] OrderLines =
    [
        new("kettle", "Gooseneck Kettle", 1, 79),
        new("beans", "Single Origin Beans 1kg", 2, 44),
    ];

    private const string Container = "display: flex; flex-direction: column; gap: 16px; padding: 24px 0;";
    private const string Greeting = "font-size: 15px; margin: 0;";
    private const string List = "list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column;";
    private const string Row = "display: flex; justify-content: space-between; padding: 10px 4px; border-bottom: 1px solid #e5e5e5; font-size: 15px;";
    private const string LineTotal = "font-weight: 600;";
    private const string InfoBlock = "border: 1px solid #e5e5e5; border-radius: 8px; padding: 16px; display: flex; flex-direction: column; gap: 6px;";
    private const string InfoRow = "font-size: 14px; margin: 0;";
    private const string Button = "background-color: #111; color: #fff; border: none; border-radius: 8px; padding: 12px 16px; font-size: 16px; font-weight: 600; cursor: pointer;";
    private const string SuccessText = "font-size: 20px; font-weight: 600; color: #0a0; text-align: center; margin: 0 0 4px;";
    private const string MutedText = "font-size: 13px; color: #666; text-align: center; margin: 0;";

    private bool _placed;
}
