<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>E2E.Acp</RootNamespace>
    <AssemblyName>E2E.Acp</AssemblyName>
    <Description>Run e2e agent steps on a coding agent you already use (Claude Code, Codex, Cursor, ...) over the Agent Client Protocol, for the community .NET port of the e2e agentic testing framework. Not an official TesterArmy product.</Description>
    <PackageId>E2E.Acp</PackageId>
    <PackageTags>e2e;testing;agent;acp;agent-client-protocol;claude-code;codex</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\E2E\E2E.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="E2E.Acp.Tests" />
  </ItemGroup>
</Project>
