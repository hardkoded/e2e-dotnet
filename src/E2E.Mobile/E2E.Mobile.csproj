<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>E2E.Mobile</RootNamespace>
    <AssemblyName>E2E.Mobile</AssemblyName>
    <Description>Mobile engine for the community .NET port of the e2e agentic testing framework. Not an official TesterArmy product.</Description>
    <PackageId>E2E.Mobile</PackageId>
    <PackageTags>e2e;testing;agent;mobile;ios;android</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\E2E\E2E.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="E2E.Mobile.Tests" />
    <InternalsVisibleTo Include="E2E.Cli" />
    <InternalsVisibleTo Include="E2E.Cli.Tests" />
  </ItemGroup>
</Project>
