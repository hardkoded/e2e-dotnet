<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>E2E.Eas</RootNamespace>
    <AssemblyName>E2E.Eas</AssemblyName>
    <Description>EAS hosted iOS and Android simulators (Expo Application Services) for the community .NET port of the e2e agentic testing framework. Not an official TesterArmy product.</Description>
    <PackageId>E2E.Eas</PackageId>
    <PackageTags>e2e;testing;agent;mobile;ios;android;eas</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\E2E.Mobile\E2E.Mobile.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="E2E.Eas.Tests" />
  </ItemGroup>
</Project>
