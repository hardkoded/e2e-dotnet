<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>E2E.TestMu.Mobile</RootNamespace>
    <AssemblyName>E2E.TestMu.Mobile</AssemblyName>
    <Description>TestMu AI real and virtual mobile devices, driven through Appium, for the community .NET port of the e2e agentic testing framework. Not an official TesterArmy product.</Description>
    <PackageId>E2E.TestMu.Mobile</PackageId>
    <PackageTags>e2e;testing;agent;mobile;ios;android;appium;testmu</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\E2E.Mobile\E2E.Mobile.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="E2E.TestMu.Mobile.Tests" />
  </ItemGroup>
</Project>
