<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>E2E.GitHub</RootNamespace>
    <AssemblyName>E2E.GitHub</AssemblyName>
    <Description>GitHub pull request comment reporter for the community .NET port of the e2e agentic testing framework. Not an official TesterArmy product.</Description>
    <PackageId>E2E.GitHub</PackageId>
    <PackageTags>e2e;testing;agent;github;reporter</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\E2E\E2E.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="E2E.GitHub.Tests" />
  </ItemGroup>
</Project>
