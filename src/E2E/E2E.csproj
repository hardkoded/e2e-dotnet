<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>E2E</RootNamespace>
    <AssemblyName>E2E</AssemblyName>
    <PackageId>E2E</PackageId>
    <Description>Community .NET port of the e2e agentic testing framework. Describe a goal, drive the app with Playwright, and check it with locators. Not an official TesterArmy product.</Description>
    <PackageTags>e2e;testing;agent;llm;playwright;web</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.14" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.100.23" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.100.22" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101.7" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\schema\*.schema.json" Pack="true" PackagePath="schema" />
    <InternalsVisibleTo Include="E2E.Tests" />
    <InternalsVisibleTo Include="E2E.Cli" />
    <InternalsVisibleTo Include="E2E.NUnit" />
    <InternalsVisibleTo Include="E2E.NUnit.Tests" />
    <InternalsVisibleTo Include="E2E.XUnit.V3" />
    <InternalsVisibleTo Include="E2E.Cli.Tests" />
    <InternalsVisibleTo Include="E2E.Mobile" />
    <InternalsVisibleTo Include="E2E.Mobile.Tests" />
    <InternalsVisibleTo Include="E2E.WinApp" />
    <InternalsVisibleTo Include="E2E.WinApp.Tests" />
  </ItemGroup>
</Project>
