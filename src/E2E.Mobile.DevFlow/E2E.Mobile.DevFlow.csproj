<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>E2E.Mobile.DevFlow</RootNamespace>
    <AssemblyName>E2E.Mobile.DevFlow</AssemblyName>
    <Description>.NET MAUI apps driven through the MAUI DevFlow agent, for the community .NET port of the e2e agentic testing framework. Not an official TesterArmy product.</Description>
    <PackageId>E2E.Mobile.DevFlow</PackageId>
    <PackageTags>e2e;testing;agent;mobile;ios;android;maui;devflow</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\E2E.Mobile\E2E.Mobile.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="E2E.Mobile.DevFlow.Tests" />
  </ItemGroup>
</Project>
