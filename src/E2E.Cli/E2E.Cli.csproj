<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>E2E.Cli</RootNamespace>
    <AssemblyName>E2E.Cli</AssemblyName>
    <PackageId>E2E.Cli</PackageId>
    <Description>The e2e command for the E2E .NET port: sign in to a model subscription (ChatGPT, GitHub Copilot, OpenCode Console, SuperGrok), sign out, list the models a login serves, and serve the guide to a coding agent over MCP (e2e mcp).</Description>
    <PackageTags>e2e;testing;agent;llm;oauth;cli;mcp</PackageTags>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <!-- One tool package for every platform: pack with the Playwright driver of each. A build ships the driver of the machine it runs on. -->
    <PlaywrightPlatform Condition="'$(_IsPacking)' == 'true'">all</PlaywrightPlatform>
    <PlaywrightPlatform Condition="'$(PlaywrightPlatform)' == ''">$(NETCoreSdkRuntimeIdentifier)</PlaywrightPlatform>
    <!-- The Playwright driver carries PowerShell scripts that are not NuGet scripts. -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>
    <ToolCommandName>e2e</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\E2E\E2E.csproj" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!-- The tool never compares screenshots, so it ships none of the SkiaSharp native libraries E2E brings in. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" ExcludeAssets="native;runtime" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.153.1" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" ExcludeAssets="all" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="E2E.Cli.Tests" />
  </ItemGroup>
  <!-- The skill ships inside the tool: e2e mcp serves it as the guide resources. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\skills\e2e-dotnet\**\*.md" LogicalName="skill/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
