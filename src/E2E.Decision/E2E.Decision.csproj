<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>E2E.Decision</RootNamespace>
    <AssemblyName>E2E.Decision</AssemblyName>
    <Description>Decision-model support (the decide call and the OpenAI Decisions API model) for the community .NET port of the e2e agentic testing framework. Not an official TesterArmy product.</Description>
    <PackageId>E2E.Decision</PackageId>
    <PackageTags>e2e;testing;agent;decision;llm</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\E2E\E2E.csproj" />
    <PackageReference Include="Vercel.Oidc" Version="0.1.0" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="E2E.Decision.Tests" />
  </ItemGroup>
</Project>
